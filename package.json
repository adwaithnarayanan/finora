{
  "name": "finora",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "db:local:start": "supabase start",
    "db:local:stop": "supabase stop",
    "db:local:setup": "node scripts/db/local.mjs setup",
    "db:local:status": "node scripts/db/local.mjs status",
    "db:local:new": "node scripts/db/local.mjs new",
    "db:local:drift": "node scripts/db/local.mjs drift",
    "db:local:reset": "node scripts/db/local.mjs reset",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:account-names": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/account-names.mjs",
    "owner:provision": "node scripts/owner/provision.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "prisma": "7.10.1",
    "shadcn": "4.22.1",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
