# Finora environment template. Copy to .env.local for local development and
# fill in values; never commit real values. Production values live in the
# hosting provider's environment settings (e.g. Vercel project settings).
#
# Local values: start the stack (`npm run db:local:start`), then read them from
# `npx supabase status` (API URL, publishable key). Tests and db scripts do NOT
# use this file; they read the local stack directly.

# --- Application (read by the Next.js server) -------------------------------

# Public origin of the app; used for absolute URLs and auth email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth. Use the PUBLISHABLE key only (sb_publishable_...).
# The app refuses to start with a secret/service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Runtime database connection as the restricted `finora_app` role.
# Local:      postgresql://finora_app:<local password>@127.0.0.1:55322/postgres
#             (password: see scripts/lib/local-supabase.mjs, local stack only)
# Production: Supavisor transaction pooler, user `finora_app.<project-ref>`, port 6543.
DATABASE_URL=
# Optional: max pooled connections per server instance (1-20, default 5).
DATABASE_POOL_MAX=

# --- Operator only (never set in the app's hosting environment) --------------

# Privileged connection for `prisma migrate deploy` and owner provisioning
# (direct or session-pooler connection as `postgres`, with ?schema=finora).
# Supply in your shell for a one-off command; do not store it with app config.
MIGRATION_DATABASE_URL=

# Supabase secret key, used only by `npm run owner:provision` for hosted
# environments. Never expose to the app or to the browser.
SUPABASE_SECRET_KEY=
