NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Publishable key only (sb_publishable_...); the app rejects secret keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Runtime connection as the restricted `finora_app` role.
DATABASE_URL=
DATABASE_POOL_MAX=

# Operator only; never set in the app's hosting environment.
MIGRATION_DATABASE_URL=
SUPABASE_SECRET_KEY=

# Deferred Google sign-in; read by `supabase start`, not the app.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
